{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:scope-home",
    "fs:scope-home-recursive",
    "fs:scope-appconfig",
    "fs:scope-appconfig-recursive",
    "fs:scope-document",
    "fs:scope-document-recursive",
    "dialog:default",
    "dialog:allow-open",
    "sql:default"
  ]
}
