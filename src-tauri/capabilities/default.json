{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the Sate window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-destroy",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:scope-home",
    "fs:scope-home-recursive",
    "fs:scope-appconfig",
    "fs:scope-appconfig-recursive",
    "fs:scope-document",
    "fs:scope-document-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}
